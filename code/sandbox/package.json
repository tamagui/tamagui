{
  "name": "sandbox",
  "version": "2.7.7",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "one dev",
    "dev:clean": "one dev --clean",
    "clean": "one clean",
    "prebuild:native": "one prebuild",
    "build:web": "one build",
    "build:native:ios": "one build --platform ios",
    "build:native:android": "one build --platform android",
    "prod": "bun run build:web && bun run serve",
    "pretest": "node -e \"const ports=[8085,8086];ports.forEach(p=>{try{require('child_process').execSync('lsof -ti:'+p+' | xargs kill -9 2>/dev/null || true',{stdio:'ignore'})}catch{}})\"",
    "test": "playwright test",
    "test:web": "playwright test",
    "test:ssr": "playwright test ssr-theme.test.ts",
    "serve": "one serve",
    "ios": "one run:ios",
    "ios:prod": "one prebuild",
    "android": "one run:android"
  },
  "dependencies": {
    "@react-native-masked-view/masked-view": "^0.3.1",
    "@tamagui/animations-css": "workspace:*",
    "@tamagui/animations-motion": "workspace:*",
    "@tamagui/colors": "workspace:*",
    "@tamagui/demos": "workspace:*",
    "@tamagui/lucide-icons-2": "workspace:*",
    "@tamagui/react-native-media-driver": "workspace:*",
    "@tamagui/toast": "workspace:*",
    "@vxrn/color-scheme": "^1.25.2",
    "expo": "~57.0.15",
    "expo-asset": "~57.0.8",
    "expo-modules-core": "~57.0.9",
    "expo-splash-screen": "~57.0.7",
    "one": "1.25.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "tamagui": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@react-native-community/cli": "15.1.3",
    "@tamagui/vite-plugin": "workspace:*",
    "@types/react": "~19.2.0",
    "vite": "^8.2.2",
    "wait-port": "^0.3.0",
    "ws": "^8.18.0"
  }
}
