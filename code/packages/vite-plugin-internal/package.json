{
  "name": "@tamagui/vite-plugin-internal",
  "version": "3.0.2",
  "private": true,
  "type": "module",
  "main": "./dist/cjs/vite.config.js",
  "module": "./dist/esm/vite.config.js",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "react-native": "./dist/esm/vite.config.native.js",
      "browser": "./dist/esm/vite.config.mjs",
      "module": "./dist/esm/vite.config.mjs",
      "import": "./dist/esm/vite.config.mjs",
      "require": "./dist/cjs/vite.config.cjs"
    }
  },
  "scripts": {
    "build": "tamagui-build",
    "test:web": "vitest --run src",
    "watch": "tamagui-build --watch",
    "clean": "tamagui-build clean",
    "clean:build": "tamagui-build clean:build"
  },
  "dependencies": {
    "@tamagui/vite-plugin": "workspace:*"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@react-native/babel-preset": "0.87.1",
    "@tamagui/build": "workspace:*",
    "@tamagui/config-default": "workspace:*",
    "@tamagui/fake-react-native": "workspace:*",
    "happy-dom": "20.8.9",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "vitest": "4.1.0",
    "vitest-axe": "^0.1.0",
    "vitest-react-native": "^0.1.5"
  },
  "peerDependencies": {
    "react": ">=19"
  }
}
