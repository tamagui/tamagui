{
  "name": "@tamagui/core",
  "version": "2.7.7",
  "license": "MIT",
  "author": {
    "name": "Nate Wienert"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tamagui/tamagui.git",
    "directory": "code/core/core"
  },
  "description": "Alias for @tamagui/style, which this package was renamed to. Re-exports it so both specifiers resolve to one module instance.",
  "sideEffects": [
    "*.css",
    "**/runtime.*"
  ],
  "files": [
    "dom.cjs",
    "dom.d.ts",
    "dom.mjs",
    "index.cjs",
    "index.d.ts",
    "index.mjs",
    "inject-styles",
    "inject-styles.cjs",
    "inject-styles.d.ts",
    "inject-styles.mjs",
    "internal-runtime",
    "internal-runtime.cjs",
    "internal-runtime.d.ts",
    "internal-runtime.mjs",
    "native",
    "native-test",
    "native-test.cjs",
    "native-test.d.ts",
    "native.cjs",
    "native.d.ts",
    "reactNativeTypes",
    "reactNativeTypes.cjs",
    "reactNativeTypes.d.ts",
    "reactNativeTypes.mjs",
    "reset.css",
    "static-resolve.cjs",
    "static-resolve.d.ts",
    "static-resolve.mjs",
    "theme-update.cjs",
    "theme-update.d.ts",
    "theme-update.mjs"
  ],
  "main": "index.cjs",
  "module": "index.mjs",
  "types": "./index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    "./reset.css": "./reset.css",
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.cjs",
      "default": "./index.mjs"
    },
    "./theme-update": {
      "types": "./theme-update.d.ts",
      "import": "./theme-update.mjs",
      "require": "./theme-update.cjs",
      "default": "./theme-update.mjs"
    },
    "./native": {
      "types": "./native.d.ts",
      "default": "./native.cjs"
    },
    "./native-test": {
      "types": "./native-test.d.ts",
      "default": "./native-test.cjs"
    },
    "./dom": {
      "types": "./dom.d.ts",
      "import": "./dom.mjs",
      "require": "./dom.cjs",
      "default": "./dom.mjs"
    },
    "./internal-runtime": {
      "types": "./internal-runtime.d.ts",
      "import": "./internal-runtime.mjs",
      "require": "./internal-runtime.cjs",
      "default": "./internal-runtime.mjs"
    },
    "./static-resolve": {
      "types": "./static-resolve.d.ts",
      "import": "./static-resolve.mjs",
      "require": "./static-resolve.cjs",
      "default": "./static-resolve.mjs"
    },
    "./inject-styles": {
      "types": "./inject-styles.d.ts",
      "import": "./inject-styles.mjs",
      "require": "./inject-styles.cjs",
      "default": "./inject-styles.cjs"
    },
    "./reactNativeTypes": {
      "types": "./reactNativeTypes.d.ts",
      "import": "./reactNativeTypes.mjs",
      "require": "./reactNativeTypes.cjs",
      "default": "./reactNativeTypes.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node sync-reset-css.mjs"
  },
  "dependencies": {
    "@tamagui/style": "workspace:*"
  }
}
