{
  "name": "tamagui-language-service",
  "displayName": "Tamagui Language Service",
  "description": "Flat value completions, diagnostics, hover, and inline color swatches for Tamagui.",
  "version": "0.0.1",
  "private": true,
  "publisher": "tamagui",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tamagui/tamagui.git",
    "directory": "code/core/language-service-vscode"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:javascriptreact",
    "onLanguage:typescriptreact"
  ],
  "files": [
    "extension.cjs",
    "LICENSE",
    "README.md"
  ],
  "main": "./extension.cjs",
  "contributes": {
    "typescriptServerPlugins": [
      {
        "name": "@tamagui/language-service",
        "enableForWorkspaceTypeScriptVersions": true
      }
    ]
  },
  "dependencies": {
    "@tamagui/language-service": "workspace:*",
    "sucrase": "3.35.1"
  }
}
