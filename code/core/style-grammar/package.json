{
  "name": "@tamagui/style-grammar",
  "version": "2.7.7",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "source": "src/index.ts",
  "files": [
    "src/backgroundFamily.ts",
    "src/borderFamily.ts",
    "src/candidate.ts",
    "src/candidateTarget.ts",
    "src/clauseIdentity.ts",
    "src/clausePrecedence.ts",
    "src/clauseCapability.ts",
    "src/clauseSources.ts",
    "src/config.ts",
    "src/evaluateProgram.ts",
    "src/fontShorthand.ts",
    "src/geometricShorthand.ts",
    "src/index.ts",
    "src/lowerProgram.ts",
    "src/modifierRegistry.ts",
    "src/modifierVocabulary.ts",
    "src/payloadShape.ts",
    "src/programEligibility.ts",
    "src/programHash.ts",
    "src/programs.ts",
    "src/registry.ts",
    "src/resolvePayload.ts",
    "src/runtime.ts",
    "src/safeAreaVariables.ts",
    "src/scanFlatValue.ts",
    "src/serializePayload.ts",
    "src/stateModifiers.ts",
    "src/states.ts",
    "src/table.ts",
    "src/textDecorationFamily.ts",
    "src/tooling.ts",
    "src/toolingAnnotations.ts",
    "src/toolingDiagnostics.ts",
    "src/toolingFormat.ts",
    "src/toolingRegistry.ts",
    "src/transformFamily.ts",
    "src/transition.ts",
    "src/transitionAlign.ts",
    "src/transitionLegacy.ts",
    "src/transitionNative.ts",
    "src/unitlessNumbers.ts",
    "src/v6ThemeNames.ts",
    "src/valueParser.ts",
    "src/valueTypes.ts",
    "types",
    "dist"
  ],
  "main": "dist/cjs/index.cjs",
  "module": "dist/esm/index.mjs",
  "types": "types/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    "./runtime": {
      "types": "./types/runtime.d.ts",
      "react-native": "./dist/esm/runtime.native.js",
      "browser": "./dist/esm/runtime.mjs",
      "module": "./dist/esm/runtime.mjs",
      "import": "./dist/esm/runtime.mjs",
      "require": "./dist/cjs/runtime.cjs",
      "default": "./dist/esm/runtime.mjs"
    },
    "./tooling": {
      "types": "./types/tooling.d.ts",
      "react-native": "./dist/esm/tooling.native.js",
      "browser": "./dist/esm/tooling.mjs",
      "module": "./dist/esm/tooling.mjs",
      "import": "./dist/esm/tooling.mjs",
      "require": "./dist/cjs/tooling.cjs",
      "default": "./dist/esm/tooling.mjs"
    },
    "./v6-themes": {
      "types": "./types/v6ThemeNames.d.ts",
      "react-native": "./dist/esm/v6ThemeNames.native.js",
      "browser": "./dist/esm/v6ThemeNames.mjs",
      "module": "./dist/esm/v6ThemeNames.mjs",
      "import": "./dist/esm/v6ThemeNames.mjs",
      "require": "./dist/cjs/v6ThemeNames.cjs",
      "default": "./dist/esm/v6ThemeNames.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "bench": "bun bench/parse-cost.mjs",
    "generate:rust": "bun scripts/generateRustGrammar.ts",
    "check:rust": "bun scripts/generateRustGrammar.ts --check",
    "build": "tamagui-build --exclude __tests__",
    "test": "vitest --run src",
    "test:web": "vitest --run src"
  },
  "dependencies": {},
  "devDependencies": {
    "@tamagui/build": "workspace:*",
    "vitest": "4.0.4"
  }
}
