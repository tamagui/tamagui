{
  "name": "@tamagui/themes",
  "version": "2.7.7",
  "license": "MIT",
  "gitHead": "a49cc7ea6b93ba384e77a4880ae48ac4a5635c14",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.mjs",
  "react-native": "./dist/esm/index.native.js",
  "types": "./types/index.d.ts",
  "files": [
    "src",
    "types",
    "dist",
    "index.cjs",
    "index.d.ts",
    "builder"
  ],
  "tamagui-build": {
    "outputs": [
      "cjs",
      "esm",
      "types"
    ]
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./types/index.d.ts",
      "react-native": "./dist/esm/index.native.js",
      "browser": "./dist/esm/index.mjs",
      "module": "./dist/esm/index.mjs",
      "import": "./dist/esm/index.mjs",
      "require": "./dist/cjs/index.cjs",
      "default": "./dist/esm/index.mjs"
    },
    "./builder": {
      "types": "./types/builder.d.ts",
      "react-native": "./dist/esm/builder.native.js",
      "browser": "./dist/esm/builder.mjs",
      "module": "./dist/esm/builder.mjs",
      "import": "./dist/esm/builder.mjs",
      "require": "./dist/cjs/builder.cjs",
      "default": "./dist/esm/builder.mjs"
    },
    "./v5": {
      "types": "./types/v5.d.ts",
      "react-native": "./dist/esm/v5.native.js",
      "browser": "./dist/esm/v5.mjs",
      "module": "./dist/esm/v5.mjs",
      "import": "./dist/esm/v5.mjs",
      "require": "./dist/cjs/v5.cjs",
      "default": "./dist/esm/v5.mjs"
    },
    "./v5-color-scales": {
      "types": "./types/v5-color-scales.d.ts",
      "react-native": "./dist/esm/v5-color-scales.native.js",
      "browser": "./dist/esm/v5-color-scales.mjs",
      "module": "./dist/esm/v5-color-scales.mjs",
      "import": "./dist/esm/v5-color-scales.mjs",
      "require": "./dist/cjs/v5-color-scales.cjs",
      "default": "./dist/esm/v5-color-scales.mjs"
    },
    "./v5-subtle": {
      "types": "./types/v5-subtle.d.ts",
      "react-native": "./dist/esm/v5-subtle.native.js",
      "browser": "./dist/esm/v5-subtle.mjs",
      "module": "./dist/esm/v5-subtle.mjs",
      "import": "./dist/esm/v5-subtle.mjs",
      "require": "./dist/cjs/v5-subtle.cjs",
      "default": "./dist/esm/v5-subtle.mjs"
    },
    "./v5-tokens": {
      "types": "./types/v5-tokens.d.ts",
      "react-native": "./dist/esm/v5-tokens.native.js",
      "browser": "./dist/esm/v5-tokens.mjs",
      "module": "./dist/esm/v5-tokens.mjs",
      "import": "./dist/esm/v5-tokens.mjs",
      "require": "./dist/cjs/v5-tokens.cjs",
      "default": "./dist/esm/v5-tokens.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "generate": "tamagui generate-themes ./src/themes.generate.ts ./src/generated.ts",
    "check:v5-color-scales": "bun ./scripts/generate-v5-color-scales.ts --check",
    "test": "bun test tests/themes.test.ts",
    "test:types": "vitest --typecheck --run tests/themes.test-d.ts",
    "build": "tamagui-build",
    "watch": "tamagui-build --watch",
    "clean": "tamagui-build clean",
    "clean:build": "tamagui-build clean:build"
  },
  "dependencies": {
    "@tamagui/create-theme": "workspace:*"
  },
  "devDependencies": {
    "@tamagui/build": "workspace:*",
    "@tamagui/cli": "workspace:*",
    "vitest": "4.1.0"
  }
}
