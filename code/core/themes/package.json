{
  "name": "@tamagui/themes",
  "version": "2.5.1",
  "gitHead": "a49cc7ea6b93ba384e77a4880ae48ac4a5635c14",
  "type": "module",
  "sideEffects": false,
  "files": [
    "src",
    "types",
    "dist",
    "v5",
    "v5-subtle",
    "v5.cjs",
    "v5.d.ts",
    "v5-subtle.cjs",
    "v5-subtle.d.ts",
    "v5-tokens.cjs",
    "v5-tokens.d.ts"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./v5": {
      "types": "./types/v5.d.ts",
      "react-native": "./dist/esm/v5.native.js",
      "browser": "./dist/esm/v5.mjs",
      "module": "./dist/esm/v5.mjs",
      "import": "./dist/esm/v5.mjs",
      "require": "./dist/cjs/v5.cjs",
      "default": "./dist/esm/v5.mjs"
    },
    "./v5-subtle": {
      "types": "./types/v5-subtle.d.ts",
      "react-native": "./dist/esm/v5-subtle.native.js",
      "browser": "./dist/esm/v5-subtle.mjs",
      "module": "./dist/esm/v5-subtle.mjs",
      "import": "./dist/esm/v5-subtle.mjs",
      "require": "./dist/cjs/v5-subtle.cjs",
      "default": "./dist/esm/v5-subtle.mjs"
    },
    "./v5-tokens": {
      "types": "./types/v5-tokens.d.ts",
      "react-native": "./dist/esm/v5-tokens.native.js",
      "browser": "./dist/esm/v5-tokens.mjs",
      "module": "./dist/esm/v5-tokens.mjs",
      "import": "./dist/esm/v5-tokens.mjs",
      "require": "./dist/cjs/v5-tokens.cjs",
      "default": "./dist/esm/v5-tokens.mjs"
    },
    "./v5-builder": {
      "types": "./types/v5-builder.d.ts",
      "react-native": "./dist/esm/v5-builder.native.js",
      "browser": "./dist/esm/v5-builder.mjs",
      "module": "./dist/esm/v5-builder.mjs",
      "import": "./dist/esm/v5-builder.mjs",
      "require": "./dist/cjs/v5-builder.cjs",
      "default": "./dist/esm/v5-builder.mjs"
    },
    "./v5-subtle-builder": {
      "types": "./types/v5-subtle-builder.d.ts",
      "react-native": "./dist/esm/v5-subtle-builder.native.js",
      "browser": "./dist/esm/v5-subtle-builder.mjs",
      "module": "./dist/esm/v5-subtle-builder.mjs",
      "import": "./dist/esm/v5-subtle-builder.mjs",
      "require": "./dist/cjs/v5-subtle-builder.cjs",
      "default": "./dist/esm/v5-subtle-builder.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "generate": "bun run generate:v5 & bun run generate:v5-subtle",
    "generate:v5": "tamagui generate-themes ./src/v5-themes.generate.ts ./src/generated-v5.ts",
    "generate:v5-subtle": "tamagui generate-themes ./src/v5-themes-subtle.generate.ts ./src/generated-v5-subtle.ts",
    "test": "bun run generate",
    "build": "tamagui-build",
    "watch": "tamagui-build --watch",
    "clean": "tamagui-build clean",
    "clean:build": "tamagui-build clean:build"
  },
  "dependencies": {
    "@tamagui/colors": "workspace:*",
    "@tamagui/theme-builder": "workspace:*"
  },
  "devDependencies": {
    "@tamagui/build": "workspace:*",
    "@tamagui/cli": "workspace:*",
    "vitest": "4.0.4"
  }
}
