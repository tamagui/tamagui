{
  "name": "@tamagui/react-native-types",
  "version": "2.7.7",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "types": "./src/index.d.ts",
  "files": [
    "src",
    "!src/**/*.test-d.*"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./src/index.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "generate": "node --experimental-strip-types scripts/generate.ts",
    "test:web": "vitest --typecheck --run"
  },
  "dependencies": {},
  "peerDependencies": {
    "react": ">=19"
  },
  "devDependencies": {
    "react-native": "0.86.2",
    "typescript": "7.0.2"
  }
}
