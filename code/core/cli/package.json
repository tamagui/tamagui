{
  "name": "@tamagui/cli",
  "version": "2.7.7",
  "license": "MIT",
  "bin": {
    "tama": "dist/index.cjs",
    "tamagui": "dist/index.cjs"
  },
  "source": "src/index.ts",
  "files": [
    "src",
    "types",
    "dist",
    "vite.cjs",
    "vite.mjs",
    "vite.d.ts",
    "metro.cjs",
    "metro.mjs",
    "metro.d.ts"
  ],
  "sideEffects": false,
  "main": "dist/index.cjs",
  "types": "./types/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./types/index.d.ts",
      "default": "./dist/index.cjs"
    },
    "./vite": {
      "types": "./vite.d.ts",
      "import": "./vite.mjs",
      "require": "./vite.cjs",
      "default": "./vite.cjs"
    },
    "./metro": {
      "types": "./metro.d.ts",
      "import": "./metro.mjs",
      "require": "./metro.cjs",
      "default": "./metro.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tamagui-build --skip-native",
    "watch": "bun run build --skip-native --watch",
    "clean": "tamagui-build clean",
    "clean:build": "tamagui-build clean:build",
    "test": "vitest run",
    "test:web": "bun run test"
  },
  "dependencies": {
    "@tamagui/generate-themes": "workspace:*",
    "@tamagui/metro-plugin": "workspace:*",
    "@tamagui/static": "workspace:*",
    "@tamagui/to-tailwind": "workspace:*",
    "@tamagui/types": "workspace:*",
    "@tamagui/vite-plugin": "workspace:*",
    "arg": "^5.0.2",
    "chalk": "^4.1.2",
    "change-case": "^4.1.2",
    "chokidar": "^3.5.2",
    "diff": "^9.0.0",
    "esbuild": "0.28.1",
    "express": "^4.18.2",
    "fs-extra": "^11.2.0",
    "get-port": "^7.0.0",
    "glob": "^13.0.3",
    "marked": "^14.1.2",
    "marked-terminal": "^5.2.0",
    "micromatch": "^4.0.7",
    "opener": "^1.5.2",
    "prompts": "2.1.0",
    "ts-morph": "^28.0.0",
    "typescript": "~6.0.3",
    "url": "^0.11.0",
    "@tamagui/language-service": "workspace:*"
  },
  "devDependencies": {
    "@tamagui/build": "workspace:*",
    "@types/chokidar": "^2.1.3",
    "@types/marked": "^5.0.0",
    "vitest": "4.1.0"
  }
}
