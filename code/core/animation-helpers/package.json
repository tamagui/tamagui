{
  "name": "@tamagui/animation-helpers",
  "version": "2.7.7",
  "gitHead": "a49cc7ea6b93ba384e77a4880ae48ac4a5635c14",
  "license": "MIT",
  "source": "src/index.ts",
  "files": [
    "src",
    "types",
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/cjs",
  "module": "dist/esm",
  "types": "./types/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    "./propertyNames": {
      "types": "./types/propertyNames.d.ts",
      "react-native": "./dist/esm/propertyNames.native.js",
      "browser": "./dist/esm/propertyNames.mjs",
      "module": "./dist/esm/propertyNames.mjs",
      "import": "./dist/esm/propertyNames.mjs",
      "require": "./dist/cjs/propertyNames.cjs",
      "default": "./dist/esm/propertyNames.mjs"
    },
    "./transitionResolver": {
      "types": "./types/transitionResolver.d.ts",
      "react-native": "./dist/esm/transitionResolver.native.js",
      "browser": "./dist/esm/transitionResolver.mjs",
      "module": "./dist/esm/transitionResolver.mjs",
      "import": "./dist/esm/transitionResolver.mjs",
      "require": "./dist/cjs/transitionResolver.cjs",
      "default": "./dist/esm/transitionResolver.mjs"
    },
    ".": {
      "types": "./types/index.d.ts",
      "react-native": "./dist/esm/index.native.js",
      "browser": "./dist/esm/index.mjs",
      "module": "./dist/esm/index.mjs",
      "import": "./dist/esm/index.mjs",
      "require": "./dist/cjs/index.cjs",
      "default": "./dist/esm/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tamagui-build",
    "watch": "tamagui-build --watch",
    "clean": "tamagui-build clean",
    "clean:build": "tamagui-build clean:build"
  },
  "devDependencies": {
    "@tamagui/build": "workspace:*"
  },
  "dependencies": {
    "@tamagui/style-grammar": "workspace:*"
  }
}
