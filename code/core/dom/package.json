{
  "name": "@tamagui/dom",
  "version": "2.5.1",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "source": "src/index.ts",
  "files": [
    "src/index.ts",
    "src/tables/attributes.ts",
    "src/tables/compatibility.ts",
    "src/tables/events.ts",
    "src/tables/nativeBacking.ts",
    "src/tables/tags.ts",
    "src/tables/types.ts",
    "types",
    "dist"
  ],
  "main": "dist/cjs/index.cjs",
  "module": "dist/esm/index.mjs",
  "types": "types/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./types/index.d.ts",
      "react-native": "./dist/esm/index.native.js",
      "browser": "./dist/esm/index.mjs",
      "module": "./dist/esm/index.mjs",
      "import": "./dist/esm/index.mjs",
      "require": "./dist/cjs/index.cjs",
      "default": "./dist/esm/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tamagui-build --exclude __tests__",
    "watch": "tamagui-build --exclude __tests__ --watch",
    "clean": "tamagui-build clean",
    "clean:build": "tamagui-build clean:build",
    "snapshot:rsd": "bun scripts/extract-rsd-snapshot.ts",
    "test": "vitest --run src"
  },
  "dependencies": {},
  "devDependencies": {
    "@tamagui/build": "workspace:*",
    "vitest": "4.0.4"
  }
}
