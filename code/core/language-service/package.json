{
  "name": "@tamagui/language-service",
  "version": "2.5.1",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "source": "src/index.ts",
  "files": [
    "index.cjs",
    "src",
    "types",
    "dist"
  ],
  "main": "index.cjs",
  "module": "dist/esm/index.mjs",
  "types": "types/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/esm/index.mjs",
      "require": "./index.cjs",
      "default": "./dist/esm/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tamagui-build --exclude test",
    "test": "bun run build && vitest --run test"
  },
  "dependencies": {
    "@tamagui/style-grammar": "workspace:*"
  },
  "peerDependencies": {
    "typescript": ">=5.7"
  },
  "devDependencies": {
    "@tamagui/build": "workspace:*",
    "typescript": "~5.9.2",
    "vitest": "4.0.4"
  }
}
