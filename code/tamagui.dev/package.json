{
  "name": "@tamagui/dot-dev",
  "version": "3.0.2",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "index.jsx",
  "scripts": {
    "assets:retain": "bun scripts/retain-assets.ts",
    "dev": "one dev",
    "dev:clean": "one dev --clean",
    "clean": "one clean",
    "serve": "one serve --port 8081",
    "serve:container": "one serve --host 0.0.0.0 --port ${PORT:-3000}",
    "build": "tamagui generate-css || true",
    "build:static": "one build && bun scripts/build-static.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "tamagui icons add --from phosphor --out components/icons $(node -p \"require('./components/icons/icons.json').join(' ')\") && oxfmt components/icons"
  },
  "dependencies": {
    "@babel/generator": "^7.25.5",
    "@babel/parser": "^7.25.4",
    "@babel/traverse": "^7.25.4",
    "@babel/types": "^7.25.4",
    "@docsearch/css": "^4.6.2",
    "@docsearch/react": "^4.6.2",
    "@github/mini-throttle": "^2.1.0",
    "@leeoniya/ufuzzy": "^1.0.14",
    "@react-navigation/core": "8.0.0-alpha.40",
    "@react-navigation/native": "8.0.0-alpha.50",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@rehookify/datepicker": "^6.6.8",
    "@tamagui/assert": "workspace:*",
    "@tamagui/config": "workspace:*",
    "@tamagui/bento": "workspace:*",
    "@tamagui/demos": "workspace:*",
    "@tamagui/get-token": "workspace:*",
    "@tamagui/helpers-icon": "workspace:*",
    "@tamagui/logo": "workspace:*",
    "@tamagui/react-native-types": "workspace:*",
    "@tamagui/tamagui-dev-config": "workspace:*",
    "@tamagui/themes": "workspace:*",
    "@tamagui/use-store": "workspace:*",
    "@tamagui/use-window-dimensions": "workspace:*",
    "@tanstack/react-table": "^8.11.2",
    "@vxrn/color-scheme": "2.0.0-0.canary.1791616071316",
    "@vxrn/mdx-rust": "2.0.0-0.canary.1791616071316",
    "color2k": "^2.0.2",
    "expo-document-picker": "~57.0.1",
    "foxact": "^0.2.33",
    "hast-util-to-html": "^8.0.3",
    "hast-util-to-string": "^2.0.0",
    "hsluv": "^0.1.0",
    "lodash-es": "4.18.1",
    "masonic": "^4.0.1",
    "one": "2.0.0-0.canary.1791616071316",
    "parse-numeric-range": "^1.3.0",
    "puppeteer": "^24.3.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-dropzone": "^14.2.3",
    "react-hotkeys-hook": "^4.5.0",
    "react-native": "0.87.1",
    "react-native-gesture-handler": "3.3.0",
    "react-native-reanimated": "4.6.0",
    "react-native-safe-area-context": "5.10.1",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.12.2",
    "refractor": "^4.7.0",
    "rehype-parse": "^8.0.4",
    "sharp": "^0.35.0",
    "swr": "^2.2.5",
