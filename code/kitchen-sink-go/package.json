{
  "name": "@tamagui/kitchen-sink-go",
  "version": "3.1.5",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start --port 8082",
    "android": "expo run:android",
    "ios": "expo run:ios",
