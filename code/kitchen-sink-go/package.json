    "test:native": "TAMAGUI_PACKAGE_EXPORTS=true bun run test:native:maestro && TAMAGUI_PACKAGE_EXPORTS=false bun run test:native:maestro",
    "test": "./run-native-tests.sh"
  },
  "dependencies": {
    "@tamagui/config": "workspace:*",
    "@tamagui/core": "workspace:*",
    "@tamagui/demos": "workspace:*",
    "@tamagui/kitchen-sink-shared": "workspace:*",
    "@tamagui/metro-plugin": "workspace:*",
    "@tamagui/toast": "workspace:*",
    "@tamagui/web": "workspace:*",
    "expo": "58.0.14",
    "expo-asset": "~58.0.16",
    "expo-font": "~58.0.8",
    "expo-modules-core": "~58.0.22",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "tamagui": "workspace:*"
  },
  "expo": {
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  }
