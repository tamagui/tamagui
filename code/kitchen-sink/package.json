{
  "name": "@tamagui/kitchen-sink",
  "version": "2.7.7",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start:one": "one dev",
    "start:web": "DISABLE_EXTRACTION=true NODE_ENV=development webpack serve",
    "start:web:prod": "NODE_ENV=production webpack serve",
    "start:web:extract": "DISABLE_EXTRACTION=false NODE_ENV=development webpack serve",
    "start": "EXPO_NO_TELEMETRY=true expo start --dev-client --offline",
    "start:extract": "TAMAGUI_OPTIMIZE_NATIVE_VIEWS=1 TAMAGUI_ENABLE_DYNAMIC_LOAD=1 bun run start",
    "start:prod": "DISABLE_EXTRACTION=false TAMAGUI_ENABLE_DYNAMIC_LOAD=1 expo start --dev-client --offline --no-dev --minify",
    "start:tamagui": "tama dev",
    "start:android": "bun run start --android",
    "start:ios": "bun run start --ios",
    "start:clean": "watchman watch-del-all & rm -r $TMPDIR/metro-cache & bun run start -c",
    "pod": "./pod-install.sh",
    "android": "EXPO_NO_TELEMETRY=true expo run:android",
    "ios": "bun run pod && EXPO_NO_TELEMETRY=true expo run:ios",
    "ios:prod": "bun run ios --configuration Release",
    "eject": "EXPO_NO_TELEMETRY=true expo eject",
    "screenshot": "node -r esbuild-register ../../node_modules/.bin/playwright test --config ./playwright-screenshot.config.ts",
    "test:native:ios": "bun run ../packages/native-ci/src/cli.ts test ios --project-root .",
    "test:native:android": "bun run ../packages/native-ci/src/cli.ts test android --project-root .",
    "test:native:maestro": "bun run ../packages/native-ci/src/cli.ts test maestro --project-root .",
    "test:web": "bun run-tests-parallel.ts",
    "test:web:seq": "NODE_ENV=test node -r esbuild-register ../../node_modules/.bin/playwright test",
    "test:web:driver": "NODE_ENV=test node -r esbuild-register ../../node_modules/.bin/playwright test",
    "test:web:debug": "NODE_ENV=test node -r esbuild-register ../../node_modules/.bin/playwright test --debug",
    "lint": "oxlint src tests",
    "typecheck": "tsc -b --pretty false",
    "detox:build:ios": "bun run pod && detox build -c ios.sim.debug",
    "detox:build:android": "detox build -c android.emu.debug",
    "detox:run:ios": "./run-detox.sh ios",
    "detox:run:android": "./run-detox.sh android",
    "prod:web": "mkdir -p dist && NODE_ENV=production webpack --json=dist/compilation-stats.json",
    "test:native": "bun run test:native:ios && bun run test:native:maestro",
    "test": "bun run test:web && ./run-native-tests.sh"
  },
  "dependencies": {
    "@expo/ui": "~57.0.12",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "7.3.16",
    "@react-navigation/native-stack": "^7.2.0",
    "@shopify/restyle": "^2.4.4",
    "@tamagui/animate-presence": "workspace:*",
    "@tamagui/animations-css": "workspace:*",
    "@tamagui/animations-motion": "workspace:*",
    "@tamagui/animations-react-native": "workspace:*",
    "@tamagui/animations-reanimated": "workspace:*",
    "@tamagui/colors": "workspace:*",
    "@tamagui/config": "workspace:*",
    "@tamagui/constants": "workspace:*",
    "@tamagui/core": "workspace:*",
    "@tamagui/demos": "workspace:*",
    "@tamagui/font-inter": "workspace:*",
    "@tamagui/get-token": "workspace:*",
    "@tamagui/input": "workspace:*",
    "@tamagui/lucide-icons-2": "workspace:*",
    "@tamagui/menu": "workspace:*",
    "@tamagui/native": "workspace:*",
    "@tamagui/native-registry": "workspace:*",
    "@tamagui/portal": "workspace:*",
    "@tamagui/sandbox-ui": "workspace:*",
    "@tamagui/scroll-view": "workspace:*",
    "@tamagui/sheet": "workspace:*",
    "@tamagui/shorthands": "workspace:*",
    "@tamagui/tailwind": "workspace:*",
    "@tamagui/theme": "workspace:*",
    "@tamagui/themes": "workspace:*",
    "@tamagui/toast": "workspace:*",
    "@tamagui/web": "workspace:*",
    "burnt": "^0.13.0",
    "expo": "~57.0.10",
    "expo-asset": "~57.0.8",
    "expo-constants": "~57.0.9",
    "expo-document-picker": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-image-picker": "~57.0.7",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.5",
    "expo-modules-core": "~57.0.9",
    "expo-splash-screen": "~57.0.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.51.0",
    "react-native": "0.86.2",
    "react-native-actions-sheet": "^10.1.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.11",
    "react-native-launch-arguments": "^4.1.1",
    "react-native-nitro-modules": "^0.36.5",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-teleport": "^1.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "solito": "^4.3.0",
    "tamagui": "workspace:*",
    "vitest": "4.0.4"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo/fingerprint": "~0.20.6",
    "@playwright/test": "1.58.2",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.10",
    "@tamagui/metro-plugin": "workspace:*",
    "@types/jest": "29.5.14",
    "@types/pngjs": "^6.0.5",
    "babel-plugin-module-resolver": "^5.0.2",
    "detox": "20.47.0",
    "html-webpack-plugin": "^5.5.0",
    "jest": "^29",
    "mini-css-extract-plugin": "^2.9.1",
    "one": "1.25.2",
    "pngjs": "^7.0.0",
    "pod-install": "^0.3.2",
    "ts-jest": "^29.4.5",
    "webpack": "^5.88.2",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.5"
  },
  "packageManager": "bun@1.3.14",
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@tamagui/native-registry",
          "react-native-launch-arguments"
        ]
      }
    }
  }
}
