{
  "expo": {
    "name": "tamagui-kitchen-sink",
    "slug": "tamagui-kitchen-sink",
    "scheme": "tamagui-kitchen-sink",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tamagui.tamaguikitchensink"
    },
    "android": {
      "package": "com.tamagui.tamaguikitchensink",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "5c027280-f9c1-4bba-9c75-762ba6efcecc"
      }
    },
    "plugins": [
      "expo-font",
      "./plugins/detox-metro-port",
      "./plugins/detox-skip-splash",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ]
  }
}
