{
  "name": "integration",
  "version": "2.7.4",
  "private": true,
  "type": "module",
  "scripts": {
    "web": "bun run dev",
    "test": "node -r esbuild-register ../../../node_modules/.bin/playwright test simple.integration.test.js",
    "test:web": "bun run test",
    "build:prod": "vite build",
    "build:ssr": "vite build --ssr src/ssr.tsx --outDir dist-ssr",
    "preview": "vite preview",
    "dev": "NODE_ENV=development vite --host --clearScreen false",
    "dev:extract": "EXTRACT=1 bun run dev",
    "prod": "NODE_ENV=production webpack --json=dist/compilation-stats.json",
    "build:ssr:streaming": "vite build --ssr src/ssr-streaming.tsx --outDir dist-ssr-streaming",
    "test:streaming": "node -r esbuild-register ../../../node_modules/.bin/playwright test streaming.integration.test.js"
  },
  "dependencies": {
    "@tamagui/animations-css": "workspace:*",
    "@tamagui/core": "workspace:*",
    "@tamagui/themes": "workspace:*",
    "@tamagui/linear-gradient": "workspace:*",
    "@tamagui/react-native-svg": "workspace:*",
    "@tamagui/shorthands": "workspace:*",
    "@tamagui/react-native-web-lite": "workspace:*",
    "@tamagui/tailwind": "workspace:*",
    "tamagui": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@tamagui/vite-plugin": "workspace:*",
    "@vitejs/plugin-react": "^6.0.0",
    "async-retry": "1.3.1",
    "react-dom": "*",
    "tailwindcss": "4.3.0",
    "vite": "^8.0.3",
    "wait-port": "^0.3.0"
  },
  "peerDependencies": {
    "react-dom": "*"
  }
}
