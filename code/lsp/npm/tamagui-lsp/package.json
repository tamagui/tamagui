  "description": "The Tamagui language server: flat value completions, diagnostics, hover and color decorators in any LSP editor",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tamagui/tamagui.git",
    "directory": "code/lsp/npm/tamagui-lsp"
