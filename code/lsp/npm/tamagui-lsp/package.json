    "@tamagui/lsp-linux-arm64-musl": "2.7.7",
    "@tamagui/lsp-linux-x64-gnu": "2.7.7",
    "@tamagui/lsp-linux-x64-musl": "2.7.7",
    "@tamagui/lsp-win32-arm64": "2.7.7",
    "@tamagui/lsp-win32-x64": "2.7.7"
