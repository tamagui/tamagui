{
  "name": "@tamagui/expo-router-starter",
  "version": "2.7.7",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "upgrade:tamagui": "bunx npm-check-updates -u '*tamagui*' '@tamagui/*' && bun install",
    "start": "bunx expo start -c",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "test": "true",
    "test:web": "true"
  },
  "dependencies": {
    "@tamagui/config": "workspace:*",
    "@tamagui/lucide-icons-2": "workspace:*",
    "@tamagui/toast": "workspace:*",
    "babel-preset-expo": "~57.0.5",
    "burnt": "^0.12.2",
    "expo": "~57.0.10",
    "expo-asset": "~57.0.8",
    "expo-build-properties": "~57.0.8",
    "expo-font": "~57.0.1",
    "expo-linking": "~57.0.5",
    "expo-router": "~57.0.10",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "tamagui": "workspace:*"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo/metro-runtime": "~57.0.8",
    "@playwright/test": "1.58.2",
    "@tamagui/babel-plugin": "workspace:*",
    "@types/react": "~19.2.0",
    "serve": "^14.2.5",
    "typescript": "~5.9.2"
  },
  "packageManager": "bun@1.3.9"
}
